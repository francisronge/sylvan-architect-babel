OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MOONSHOT_API_KEY=your_moonshot_api_key_here
XAI_API_KEY=your_xai_api_key_here
# The model picker uses exact IDs and native effort settings from researchModelCatalog.js.
# The following model overrides apply only to older modelRoute-based API callers.
# GEMINI_API_KEY=your_gemini_api_key_here
# Gemini defaults to gemini-3.1-pro-preview
# GEMINI_MODEL=gemini-3.1-pro-preview
# Gemini benchmark reasoning accepts low, medium, or high; defaults to high
# GEMINI_THINKING_LEVEL=high
# GPT defaults to gpt-5.5
# OPENAI_MODEL=gpt-5.5
# GPT reasoning effort defaults to xhigh for derivation stability
# OPENAI_REASONING_EFFORT=xhigh
# GPT benchmark calls use one background Responses API job, then poll its status
# OPENAI_BACKGROUND_RESPONSES=1
# OPENAI_BACKGROUND_POLL_INTERVAL_MS=5000
# Claude defaults to claude-opus-4-8
# ANTHROPIC_MODEL=claude-opus-4-8
# Claude benchmark reasoning defaults to adaptive thinking with max effort
# ANTHROPIC_EFFORT=max
# GEMINI_MAX_OUTPUT_TOKENS=32768
# GEMINI_ROUTE_MAX_OUTPUT_TOKENS=32768
# GEMINI_ROUTE_TEMPERATURE=0.2
# GEMINI_ROUTE_TIMEOUT_MS=900000
# GEMINI_ROUTE_REQUEST_BUDGET_MS=900000
# OPENAI_MAX_OUTPUT_TOKENS=32768
# ANTHROPIC_MAX_OUTPUT_TOKENS=32768
# Total external-provider wait, including retries/polling. The host must allow
# this budget plus time for normalization and delivery. vercel.json allows 960s
# for the default 900s budget; increasing this value needs a matching host limit.
# Vercel requires Pro/Enterprise extended duration for this configuration.
# BABEL_PROVIDER_REQUEST_BUDGET_MS=900000
# --- Security hardening (recommended for deployment) ---
# Address `npm start` listens on (default: 127.0.0.1 in local runtime, every
# interface in production). Set 0.0.0.0 to reach a local runtime from other devices;
# open it at this machine's IP address (http://192.168.1.20:3000), which the
# local host check below always admits.
# BABEL_LISTEN_HOST=127.0.0.1
# Trust-proxy setting for Express (default: 1 in production, false in local runtime).
# BABEL_TRUST_PROXY=1
# Optional strict origin allow-list for /api/parse (comma-separated full origins).
# When set, it replaces the same-origin check, so list every origin that serves
# the app. Every runtime (Express, the hosted function, Vite) applies it alike.
# Example: BABEL_ALLOWED_ORIGINS=https://babel.example.com,https://www.babel.example.com
# BABEL_ALLOWED_ORIGINS=
# Require Origin checks in production (default: true in production, false in local runtime).
# BABEL_REQUIRE_ORIGIN=true
# Allow requests without Origin header (default: false in production).
# BABEL_ALLOW_NO_ORIGIN=false
# Optional API token gate for /api/parse, for deployments serving only API callers.
# If set, every caller must send header: x-babel-api-token: <token>
# Babel's browser app never sends this header, since a token in the browser bundle
# would be public, so setting it makes the app's Generate requests fail with 401.
# Leave it unset for a browser deployment. Origin checks do not authenticate callers;
# public deployments still need the abuse and spend controls in ROADMAP.md Program 5.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BABEL_PARSE_API_TOKEN=replace_with_long_random_token
# Local runtimes (Vite dev server, a non-production `npm start`) answer only
# requests whose Host is localhost, *.localhost or an IP address, so a web page
# that rebinds its own DNS name to 127.0.0.1 cannot spend the keys above. A
# browser Origin, when sent, must be the app on that same host (or be listed in
# BABEL_ALLOWED_ORIGINS). List any other names you deliberately use, such as a
# tunnel or a .local name; a leading dot admits the domain and its subdomains.
# Production ignores this list. Example: BABEL_DEV_ALLOWED_HOSTS=.trycloudflare.com
# BABEL_DEV_ALLOWED_HOSTS=
# Rate and abuse controls:
# BABEL_PARSE_RATE_LIMIT_PER_MINUTE=30
# BABEL_PARSE_DAILY_LIMIT_PER_IP=1200
# BABEL_MAX_IN_FLIGHT_PARSES=8
# Optional legacy Gemini-only timeout override:
# GEMINI_MODEL_TIMEOUT_MS=900000
# Shared hosted-provider timeout (used when a route-specific override is absent):
# BABEL_PROVIDER_MODEL_TIMEOUT_MS=900000
