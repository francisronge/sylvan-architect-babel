{
  "name": "sylvan-architect-babel",
  "private": true,
  "version": "0.1.0-beta",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "fixtures:build": "node scripts/buildParseFixtures.mjs",
    "fixtures:replay": "node scripts/buildReplaySnapshots.mjs",
    "verify:parse-contract": "node scripts/verifyParseContract.mjs",
    "verify:offline": "npm test && npm run verify:parse-contract",
    "verify:all": "npm run typecheck && npm run verify:offline",
    "qualification:smoke": "node scripts/buildContractQualificationDryRun.mjs",
    "qualification:review": "node scripts/buildContractQualificationReview.mjs",
    "tier2:review:build": "node scripts/buildTier2VisualReview.mjs",
    "tier2:review:verify": "node scripts/verifyTier2VisualReview.mjs",
    "orchard:verify": "node scripts/verifyRelationOrchard.cjs",
    "release:verify-assets": "node scripts/verifyReleaseAssets.mjs",
    "preview": "vite preview",
    "start": "node server/index.js",
    "local:provider-effort": "node .artifacts/provider_effort_local_test.cjs",
    "audit": "npm audit"
  },
  "dependencies": {
    "@fontsource/crimson-pro": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/quicksand": "^5.2.10",
    "@google/genai": "^1.42.0",
    "d3": "^7.9.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "esbuild": "^0.25.12",
    "playwright": "^1.62.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "rimraf": "6.1.3"
  }
}
