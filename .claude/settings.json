{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/prCheckGuard.mjs\"; [ -f \"$f\" ] && node \"$f\" || true",
            "timeout": 30,
            "statusMessage": "Checking open PRs for failing CI"
          }
        ]
      }
    ]
  }
}
